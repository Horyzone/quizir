# ==========================================
# Quizir - Environment Variables Configuration
# ==========================================

# Database Configuration
DATABASE_URL=ecto://quizir:quizir@localhost:5432/quizir_dev
# POOL_SIZE=10

# Secret Key Base (generate with: mix phx.gen.secret)
# SECRET_KEY_BASE=

# Endpoint Configuration
# PHX_SERVER=true
# PORT=4000
# PHX_HOST=example.com

# ==========================================
# SMTP Mailer Configuration
# ==========================================
# Hostname or IP address of the SMTP server (e.g. smtp.mailgun.org, smtp.sendgrid.net, mail.mycompany.com)
SMTP_HOST=smtp.example.com

# Port of the SMTP server (default: 587 for STARTTLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP Authentication credentials
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# SSL / TLS Settings
# SMTP_SSL=false        # Set to true for port 465 (implicit SSL)
# SMTP_TLS=if_available # Options: if_available, always, never (STARTTLS)
# SMTP_TLS_VERIFY=peer  # Options: peer (default, verifies CA certs), none (skips cert verification)
# SMTP_AUTH=always      # Options: always, if_available, never
# SMTP_RETRIES=1        # Number of retries on delivery failure

# Sender identity for emails (e.g. forgot password emails)
SMTP_FROM_EMAIL=contact@quizir.app
SMTP_FROM_NAME=Quizir
