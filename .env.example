# ==========================================
# Quizir - Environment Variables Configuration
# ==========================================

# Database Configuration
DATABASE_URL=ecto://quizir:quizir@localhost:5432/quizir_dev
# POOL_SIZE=10

# Secret Key Base (generate with: mix phx.gen.secret)
# SECRET_KEY_BASE=

# ==========================================
# Reverse Proxy & Host Configuration (HTTPS)
# ==========================================
# Domain name for the application (e.g. quiz.horyzone.fr)
PHX_HOST=localhost

# Protocol scheme (https or http) and external port of the reverse proxy
# PHX_SCHEME=https
# PHX_PORT=443

# Internal listening port of Phoenix within the container
# PORT=4000

# WebSocket / LiveView Origin check (crucial behind reverse proxies):
# Comma-separated list of allowed origins, or "false" to allow any origin.
# By default, PHX_HOST, localhost, and 127.0.0.1 are automatically allowed.
# CHECK_ORIGIN=https://quiz.horyzone.fr
# CHECK_ORIGIN=false

# Force SSL redirection (true by default in prod, set to false if reverse proxy handles HTTP->HTTPS)
# FORCE_SSL=true

# ==========================================
# SMTP Mailer Configuration
# ==========================================
# Hostname or IP address of the SMTP server (e.g. smtp.mailgun.org, smtp.sendgrid.net, mail.mycompany.com)
SMTP_HOST=smtp.example.com

# Port of the SMTP server (default: 587 for STARTTLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP Authentication credentials
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# SSL / TLS Settings
# SMTP_SSL=false        # Set to true for port 465 (implicit SSL)
# SMTP_TLS=if_available # Options: if_available, always, never (STARTTLS)
# SMTP_TLS_VERIFY=peer  # Options: peer (default, verifies CA certs), none (skips cert verification)
# SMTP_AUTH=always      # Options: always, if_available, never
# SMTP_RETRIES=1        # Number of retries on delivery failure

# Sender identity for emails (e.g. forgot password emails)
SMTP_FROM_EMAIL=contact@quizir.app
SMTP_FROM_NAME=Quizir

# ==========================================
# S3 Object Storage Configuration (Optional)
# ==========================================
# Image uploading is ONLY enabled if S3 is configured below.
# If omitted, image uploading is disabled across the application.
# S3_BUCKET=my-quizir-bucket
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_REGION=eu-west-3
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_PUBLIC_URL=https://cdn.quizir.app

